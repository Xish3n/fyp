# Copy to .env and fill in. Never commit .env.

# LLM provider: groq or openrouter
LLM_PROVIDER=
# Model id; must be listed in configs/models.yaml
LLM_MODEL=

GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional, for external tracing only; never used for generation
OPENAI_API_KEY=

# Parent directory for generated projects (Linux path)
DEFAULT_PROJECT_PATH=/home/<user>/SRSProjects
# SQLite file for run records (default: data/srs_agent.sqlite3 in the project)
DB_PATH=
# dev or experiment
RUN_MODE=dev
